# ---------------------------------------------------------------------------
# Environment variables
#
# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored.
# Never commit real secrets. Only variables prefixed with NEXT_PUBLIC_ are
# exposed to the browser — never put credentials in one (TRD section 14).
# ---------------------------------------------------------------------------

# Public site origin, used for canonical URLs, sitemap, and OG images.
# No trailing slash. Example: https://bamideleidowu.com
SITE_URL=http://localhost:3000

# Where contact enquiries are delivered. Server-only.
CONTACT_EMAIL_TO=

# Transactional email provider (Resend). Server-only.
# When EMAIL_API_KEY is empty the contact API validates and accepts requests
# but does not deliver them, and logs a warning. This keeps local development
# working without credentials. Contact submission MUST NOT go live like this.
EMAIL_API_KEY=

# Verified sender identity at the email provider. Server-only.
# Example: "Portfolio Enquiries <enquiries@bamideleidowu.com>"
EMAIL_FROM=

# --- Analytics (optional, privacy-friendly) ---------------------------------
# Leave unset to disable analytics entirely. The site stays fully functional.
# When set, a single lightweight script tag is injected and custom events are
# forwarded to it. No cookies, no personal data, no form contents are sent.

# Plausible-compatible script origin. Example: https://plausible.io
NEXT_PUBLIC_ANALYTICS_SRC=
# Your site identifier at that provider. Example: bamideleidowu.com
NEXT_PUBLIC_ANALYTICS_DOMAIN=
